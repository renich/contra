classes: {
  gcp_tier: {
    style: {
      fill: "#0f172a"
      stroke: "#38bdf8"
      stroke-width: 2
      font-color: "#f8fafc"
      border-radius: 8
    }
  }
  routing_tier: {
    style: {
      fill: "#0f172a"
      stroke: "#f59e0b"
      stroke-width: 2
      font-color: "#f8fafc"
      border-radius: 8
    }
  }
  openstack_tier: {
    style: {
      fill: "#0f172a"
      stroke: "#10b981"
      stroke-width: 2
      font-color: "#f8fafc"
      border-radius: 8
    }
  }
  node_box: {
    style: {
      fill: "#1e293b"
      stroke: "#334155"
      stroke-width: 1
      font-color: "#f8fafc"
      border-radius: 6
    }
  }
}

grid-columns: 3
grid-gap: 40

gcp_sdn: "GCP VPC Software-Defined Network\n(No Native L2 Broadcast / No VIPs)" {
  class: gcp_tier
  
  ilb: "GCP Internal Load Balancer (ILB)\n(Multi-Zone Health Probes)" { class: node_box }
  routes: "GCP Custom Route Tables\n(Next-Hop Static VIP Routes)" { class: node_box }
  vpc_net: "GCP Regional VPC Subnets\n(High-Bandwidth Inter-Zone Network)" { class: node_box }

  ilb -> routes: Failover
  routes -> vpc_net: Ingress
}

routing_layer: "Kernel Routing & Adapter Layer\n(Bypasses GCP L2 SDN Drop)" {
  class: routing_tier

  dummy: "Linux Dummy Interfaces (dummy0)\n(Local VIP Binding on Host)" { class: node_box }
  policy: "Advanced Policy Routing\n(Custom ip rule & ip route Tables)" { class: node_box }
  probes: "Health-Check Response Probes\n(Sub-Second Failover Signal)" { class: node_box }

  dummy -> policy: VIP Packets
  policy -> probes: Status
}

control_plane: "HA OpenStack Control Plane\n(CentOS Stream 10 / Rootless Podman)" {
  class: openstack_tier

  node1: "Controller 01 (Active Leader)\n(Keystone, Nova, Neutron API)" { class: node_box }
  node2: "Controller 02 (Hot Standby)\n(Galera DB, RabbitMQ Quorum)" { class: node_box }
  node3: "Controller 03 (Hot Standby)\n(State Synchronization & Arbiter)" { class: node_box }

  node1 <-> node2
  node2 <-> node3
}

gcp_sdn -> routing_layer: "L3 Health Checks & Traffic"
routing_layer -> control_plane: "Dispatched API Requests"
