direction: right

classes: {
  gcp_sdn: {
    style: {
      fill: "#181825"
      stroke: "#89b4fa"
      stroke-width: 2
      font-color: "#cdd6f4"
    }
  }
  openstack_cp: {
    style: {
      fill: "#1e1e2e"
      stroke: "#fab387"
      stroke-width: 2
      font-color: "#cdd6f4"
    }
  }
  overlay_hack: {
    style: {
      fill: "#313244"
      stroke: "#a6e3a1"
      stroke-width: 2
      font-color: "#cdd6f4"
    }
  }
}

title: "Modelyo HA OpenStack Control Plane on GCP VPC: L2/L3 Routing Solution" {
  near: top-center
  shape: text
  style: {
    font-size: 22
    bold: true
  }
}

gcp_vpc: "GCP VPC Software-Defined Network (No L2 Broadcast / No VIPs)" {
  class: gcp_sdn

  ilb: "GCP Internal Load Balancer (ILB)\n(Multi-Zone Health Checks)"
  routes: "GCP Custom Route Tables\n(Next-Hop Instance Routing)"
  ilb -> routes: "Sub-Second Backend Failover"
}

routing_layer: "Kernel Routing & Dummy Interface Adaptation Layer" {
  class: overlay_hack

  dummy_net: "Linux Dummy Interfaces (dummy0)\n(Simulated VIP Binding)"
  ip_rules: "Policy Routing (ip rule / ip route)\n(Bypasses GCP ARP/L2 Drop)"
  dummy_net -> ip_rules: "Local VIP Packet Processing"
}

controllers: "HA OpenStack Control Plane (CentOS Stream 10)" {
  class: openstack_cp

  node1: "Controller 01 (Active)\n(Keystone, Nova, Neutron API)"
  node2: "Controller 02 (Standby)\n(Galera DB, RabbitMQ Cluster)"
  node3: "Controller 03 (Standby)\n(State Synchronization)"

  node1 <-> node2 <-> node3: "Quorum & State Replication"
}

gcp_vpc.ilb -> controllers.node1: "Active Health Probe (Pass)"
gcp_vpc.ilb -> controllers.node2: "Standby Health Probe (Pass)"
controllers.node1 -> routing_layer.dummy_net: "Binds VIP to dummy0"
routing_layer.ip_rules -> controllers.node1: "Processes Inbound Requests"
