classes: {
  source_tier: {
    style: {
      fill: "#0f172a"
      stroke: "#f43f5e"
      stroke-width: 2
      font-color: "#f8fafc"
      border-radius: 8
    }
  }
  orchestrator_tier: {
    style: {
      fill: "#0f172a"
      stroke: "#f59e0b"
      stroke-width: 2
      font-color: "#f8fafc"
      border-radius: 8
    }
  }
  target_tier: {
    style: {
      fill: "#0f172a"
      stroke: "#10b981"
      stroke-width: 2
      font-color: "#f8fafc"
      border-radius: 8
    }
  }
  node_box: {
    style: {
      fill: "#1e293b"
      stroke: "#334155"
      stroke-width: 1
      font-color: "#f8fafc"
      border-radius: 6
    }
  }
}

grid-columns: 3
grid-gap: 40

source: "Legacy Private Cloud\n(RHOSP 16.2 / OpenStack)" {
  class: source_tier
  
  cp: "RHOSP 16.2 Control Plane\n(Nova, Neutron, Keystone)" { class: node_box }
  vms: "4,500+ Active Virtual Instances\n(Civic & Public Services)" { class: node_box }
  storage: "Legacy Ceph Storage Cluster\n(Block & Object Pools)" { class: node_box }

  cp -> vms: Manages
  vms -> storage: Attached Disks
}

pipe: "Automated Migration Engine\n(Make + Python + os-migrate)" {
  class: orchestrator_tier

  extract: "1. Metadata Serialization\n(Users, Networks, Quotas)" { class: node_box }
  waves: "2. Batch Wave Scheduler\n(Live Snapshotting & Data Sync)" { class: node_box }
  audit: "3. Pre/Post-Flight Verifier\n(Zero-Loss Checksums & Handover)" { class: node_box }

  extract -> waves: Serializes
  waves -> audit: Replicates
}

target: "Target Sovereign Cloud\n(RHOSO 18 / OpenShift OKD)" {
  class: target_tier

  rhoso: "RHOSO 18 on OpenShift\n(Container-Native Control Plane)" { class: node_box }
  modern_vms: "Modernized Tenant Workloads\n(CentOS Stream / RHEL 9)" { class: node_box }
  ceph9: "Red Hat Ceph Storage 9\n(Distributed ODF Storage Fabric)" { class: node_box }

  rhoso -> modern_vms: Orchestrates
  modern_vms -> ceph9: Persistent Volumes
}

source -> pipe: "Extracts State"
pipe -> target: "Deploys & Verifies"
