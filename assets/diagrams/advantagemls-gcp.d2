classes: {
  edge_tier: {
    style: {
      fill: "#0f172a"
      stroke: "#38bdf8"
      stroke-width: 2
      font-color: "#f8fafc"
      border-radius: 8
    }
  }
  compute_tier: {
    style: {
      fill: "#0f172a"
      stroke: "#10b981"
      stroke-width: 2
      font-color: "#f8fafc"
      border-radius: 8
    }
  }
  storage_tier: {
    style: {
      fill: "#0f172a"
      stroke: "#a855f7"
      stroke-width: 2
      font-color: "#f8fafc"
      border-radius: 8
    }
  }
  node_box: {
    style: {
      fill: "#1e293b"
      stroke: "#334155"
      stroke-width: 1
      font-color: "#f8fafc"
      border-radius: 6
    }
  }
}

grid-columns: 3
grid-gap: 40

edge: "Cloud Edge & Optimization Tier\n(Slashes Network Egress Spend)" {
  class: edge_tier
  
  traffic: "Broker & Public Buyer Traffic\n(Thousands Concurrent Users)" { class: node_box }
  cdn: "Google Cloud CDN Edge Rules\n(Cache Hit Ratio Exceeds 85%)" { class: node_box }
  lb: "Cloud Load Balancers (HTTPS)\n(Path Routing & SSL Offload)" { class: node_box }

  traffic -> cdn: Requests
  cdn -> lb: Dynamic Pass
}

compute: "Modernized Compute Fleet\n(CentOS Stream 10 / Zero Downtime)" {
  class: compute_tier

  vanity: "Vanity Sites Cluster\n(SELinux Enforcing / Hardened)" { class: node_box }
  api: "Real-Time MLS Data Sync APIs\n(Right-Sized Machine Families)" { class: node_box }
  scheduler: "Instance Lifecycle Scheduler\n(Auto-Parks Non-Prod Resources)" { class: node_box }

  vanity -> api: Data Sync
  scheduler -> vanity: Schedules
}

persistence_iac: "Persistence & OpenTofu Automation\n(Zero-Downtime Rolling Delivery)" {
  class: storage_tier

  db: "Managed Database Backend\n(Automated Failover & PITR)" { class: node_box }
  gcs: "Cloud Storage (GCS)\n(Lifecycle Rules / Coldline)" { class: node_box }
  tofu: "OpenTofu IaC & GitLab CI\n(Zero-Downtime Canary Updates)" { class: node_box }

  tofu -> db: Provisions
  tofu -> gcs: Configures
}

edge -> compute: "Optimized Traffic"
compute -> persistence_iac: "Transactional I/O"
