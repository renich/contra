classes: {
  global_tier: {
    style: {
      fill: "#0f172a"
      stroke: "#38bdf8"
      stroke-width: 2
      font-color: "#f8fafc"
      border-radius: 8
    }
  }
  hypervisor_tier: {
    style: {
      fill: "#0f172a"
      stroke: "#f43f5e"
      stroke-width: 2
      font-color: "#f8fafc"
      border-radius: 8
    }
  }
  storage_tier: {
    style: {
      fill: "#0f172a"
      stroke: "#a855f7"
      stroke-width: 2
      font-color: "#f8fafc"
      border-radius: 8
    }
  }
  node_box: {
    style: {
      fill: "#1e293b"
      stroke: "#334155"
      stroke-width: 1
      font-color: "#f8fafc"
      border-radius: 6
    }
  }
}

grid-columns: 3
grid-gap: 40

global_fleet: "Global Datacenter Footprint\n(10 Datacenters / ~20 Regions)" {
  class: global_tier
  
  na: "North America Datacenters\n(Equinix / CoreSite)" { class: node_box }
  eu: "Europe & Middle East Datacenters\n(Interxion / Telehouse)" { class: node_box }
  apac: "Asia-Pacific Datacenters\n(Equinix Tokyo / Singapore)" { class: node_box }

  na -> eu
  eu -> apac
}

hypervisors: "Hardened KVM Hypervisor Fleet\n(99.95% Availability Across 10 DCs)" {
  class: hypervisor_tier

  kvm: "KVM Kernel Module & Libvirt\n(CPU Pinning, Hugepages Tuning)" { class: node_box }
  selinux: "SELinux Multi-Tenant Isolation\n(Strict Type Enforcement / Zero Escape)" { class: node_box }
  vms: "150,000+ Active Tenant VMs\n(Multi-Tenant Workload Density)" { class: node_box }

  kvm -> selinux: Confines
  selinux -> vms: Supervises
}

storage: "Distributed S3 Object Storage Cluster\n(Podman Managed Architecture)" {
  class: storage_tier

  net: "10GbE / 40GbE Bonded Ingress\n(Jumbo Frames MTU 9000 & TCP Tuning)" { class: node_box }
  podman: "Podman Minio Object Storage\n(+40% Throughput vs Legacy Docker)" { class: node_box }
  fs: "High-Throughput Storage Fabric\n(Distributed Ceph & ZFS Pools)" { class: node_box }

  net -> podman: Ingress
  podman -> fs: Persistent I/O
}

global_fleet -> hypervisors: "Provisions & Scales"
hypervisors -> storage: "S3 API Storage I/O"
